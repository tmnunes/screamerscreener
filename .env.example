# EODHD (backend only — never expose to the browser)
EODHD_API_KEY=
MAX_EODHD_REQUESTS_PER_RUN=18

# FreeCryptoAPI (backend only — never expose to the browser)
# Docs: https://freecryptoapi.com/sdk
FREECRYPTOAPI_API_KEY=
MAX_FREECRYPTOAPI_REQUESTS_PER_RUN=40
CRYPTO_TOP_N=25
CRYPTO_HISTORY_DAYS=730

# Supabase (backend)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase (frontend — public anon key only)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Backend API (frontend uses this)
NEXT_PUBLIC_API_URL=http://localhost:8000

ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Production example (comma-separated):
# ALLOWED_ORIGINS=https://your-app.vercel.app

# Optional: Vortex defaults
VORTEX_LENGTH=47
VORTEX_MULT=1.6
VORTEX_SOURCE=hlc3
