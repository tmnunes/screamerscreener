# EODHD (backend only — never expose to the browser)
EODHD_API_KEY=
MAX_EODHD_REQUESTS_PER_RUN=18

# Supabase (backend)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase (frontend — public anon key only)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Backend API (frontend uses this)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional: Vortex defaults (overridable by CLI flags)
VORTEX_LENGTH=47
VORTEX_MULT=1.6
VORTEX_SOURCE=hlc3
