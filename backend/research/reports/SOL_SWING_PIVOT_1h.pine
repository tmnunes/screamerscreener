//@version=5
// ScreamerScreener: SOL major-swing ZigZag fade (1H)
//
// Your circles = large swing tops/bottoms only. Fixed-bar pivots were too noisy.
// This confirms a swing only after price reverses by ZigZag % from the extreme.
//
//   reverse DOWN  zigZagPct from peak → SELL (short)
//   reverse UP    zigZagPct from trough → BUY (long)
//
// Chart: SOLUSDT.P · 1H
// Start with ZigZag %=5. If still too many signals → 6 or 7. If missing circles → 4.
// Orange markers = confirmed swing extremes. Triangles = entry bar (after reverse).

strategy(
     title             = "SOL ZigZag Swing Fade (1H)",
     shorttitle        = "SOL_ZZ_1h",
     overlay           = true,
     pyramiding        = 0,
     initial_capital   = 100000,
     default_qty_type  = strategy.percent_of_equity,
     default_qty_value = 100,
     commission_type   = strategy.commission.percent,
     commission_value  = 0.04,
     process_orders_on_close = false,
     calc_on_every_tick = false
 )

zigZagPct = input.float(5.0, "ZigZag %", minval=1.0, maxval=20.0, step=0.5) / 100.0
atrLen    = input.int(14, "ATR length")
stopMult  = input.float(4.0, "Stop ATR mult", step=0.1)
takeMult  = input.float(1.5, "Take ATR mult", step=0.1)
useStops  = input.bool(true, "Use ATR stop/take")

atrR = ta.atr(atrLen)

// dir:  1 = last confirmed was LOW  (now tracking a HIGH)
//      -1 = last confirmed was HIGH (now tracking a LOW)
//       0 = not initialized
var int   dir      = 0
var float extPrice = na
var float lastZZ   = na

buySignal  = false
sellSignal = false

if bar_index == 0 or na(extPrice)
    extPrice := close
    dir := 1

if dir == 1
    // tracking high since last low
    if high > extPrice
        extPrice := high
    else if (extPrice - low) / extPrice >= zigZagPct
        sellSignal := true
        lastZZ := extPrice
        dir := -1
        extPrice := low
else if dir == -1
    // tracking low since last high
    if low < extPrice
        extPrice := low
    else if (high - extPrice) / extPrice >= zigZagPct
        buySignal := true
        lastZZ := extPrice
        dir := 1
        extPrice := high

longCond  = buySignal and strategy.position_size <= 0
shortCond = sellSignal and strategy.position_size >= 0

if longCond
    strategy.entry("Long", strategy.long)
if shortCond
    strategy.entry("Short", strategy.short)

var float stopLevel = na
var float takeLevel = na

longJustOpened  = strategy.position_size > 0 and strategy.position_size[1] <= 0
shortJustOpened = strategy.position_size < 0 and strategy.position_size[1] >= 0

if longJustOpened
    stopLevel := strategy.position_avg_price - stopMult * atrR
    takeLevel := strategy.position_avg_price + takeMult * atrR
if shortJustOpened
    stopLevel := strategy.position_avg_price + stopMult * atrR
    takeLevel := strategy.position_avg_price - takeMult * atrR

if useStops and strategy.position_size > 0 and not na(stopLevel)
    strategy.exit("L-exit", from_entry="Long", stop=stopLevel, limit=takeLevel)
if useStops and strategy.position_size < 0 and not na(stopLevel)
    strategy.exit("S-exit", from_entry="Short", stop=stopLevel, limit=takeLevel)

if strategy.position_size == 0 and strategy.position_size[1] != 0
    stopLevel := na
    takeLevel := na

plot(lastZZ, "Last swing extreme", color=color.orange, style=plot.style_circles, linewidth=3)
plotshape(buySignal, title="BUY", style=shape.triangleup, location=location.belowbar, color=color.lime, size=size.small)
plotshape(sellSignal, title="SELL", style=shape.triangledown, location=location.abovebar, color=color.red, size=size.small)
