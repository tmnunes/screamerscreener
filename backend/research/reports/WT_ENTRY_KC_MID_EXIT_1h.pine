//@version=5
// ScreamerScreener hybrid: WaveTrend ENTRY + Keltner MID EXIT (1H)
//
// Entry (LazyBear WaveTrend momentum turn):
//   Long  = WT1 crosses above WT2 while WT1 <= oversold
//   Short = WT1 crosses below WT2 while WT1 >= overbought
//
// Exit: Keltner mid cross (same mid as your TV winner: EMA20 / ATR12×3.1)
//       + fixed ATR stop/take at entry (SL 2.7 / TP 3.5)
//
// Chart: ETHUSDT.P (Binance) · 1H
// Judge on Strategy Tester. If too many trades: raise |OB/OS| (e.g. 60/-60).
// If too few: lower to 45/-45 or set "Require extreme" OFF (any WT cross).

strategy(
     title             = "WT entry + KC mid exit (1H)",
     shorttitle        = "WT_KC_MID",
     overlay           = true,
     pyramiding        = 0,
     initial_capital   = 100000,
     default_qty_type  = strategy.percent_of_equity,
     default_qty_value = 100,
     commission_type   = strategy.commission.percent,
     commission_value  = 0.04,
     process_orders_on_close = false,
     calc_on_every_tick = false
 )

// ---- WaveTrend (entries) ----
chLen        = input.int(10, "WT Channel Length")
avgLen       = input.int(21, "WT Average Length")
obLevel      = input.float(53.0, "Overbought", step=1)
osLevel      = input.float(-53.0, "Oversold", step=1)
requireExtreme = input.bool(true, "Require WT extreme (OB/OS) on cross")

// ---- Keltner mid (exits) — matches your ~78% band mid ----
lenKC      = input.int(20, "Keltner EMA length")
atrKC      = input.int(12, "Keltner ATR length")
multKC     = input.float(3.1, "Keltner ATR mult", step=0.1)
useMidExit = input.bool(true, "Exit on KC mid cross")

// ---- Risk ----
atrRisk    = input.int(14, "Risk ATR length")
stopMult   = input.float(2.7, "Stop ATR mult", step=0.1)
takeMult   = input.float(3.5, "Take ATR mult", step=0.1)

// WaveTrend
ap  = hlc3
esa = ta.ema(ap, chLen)
d   = ta.ema(math.abs(ap - esa), chLen)
ci  = (ap - esa) / (0.015 * d)
wt1 = ta.ema(ci, avgLen)
wt2 = ta.sma(wt1, 4)

crossUp = ta.crossover(wt1, wt2)
crossDn = ta.crossunder(wt1, wt2)

buySignal  = crossUp and (not requireExtreme or wt1 <= osLevel)
sellSignal = crossDn and (not requireExtreme or wt1 >= obLevel)

// Keltner (mid used for exit; bands plotted for context)
mid   = ta.ema(close, lenKC)
atrBand = ta.atr(atrKC)
upper = mid + multKC * atrBand
lower = mid - multKC * atrBand
atrR  = ta.atr(atrRisk)

plot(mid, "KC mid", color=color.orange, linewidth=2)
plot(upper, "KC upper", color=color.new(color.teal, 40))
plot(lower, "KC lower", color=color.new(color.teal, 40))

longCond  = buySignal and strategy.position_size == 0
shortCond = sellSignal and strategy.position_size == 0
flatLong  = useMidExit and close < mid
flatShort = useMidExit and close > mid

var float stopLevel = na
var float takeLevel = na

if longCond
    strategy.entry("Long", strategy.long)
if shortCond
    strategy.entry("Short", strategy.short)

longJustOpened  = strategy.position_size > 0 and strategy.position_size[1] <= 0
shortJustOpened = strategy.position_size < 0 and strategy.position_size[1] >= 0

if longJustOpened
    stopLevel := strategy.position_avg_price - stopMult * atrR
    takeLevel := strategy.position_avg_price + takeMult * atrR
if shortJustOpened
    stopLevel := strategy.position_avg_price + stopMult * atrR
    takeLevel := strategy.position_avg_price - takeMult * atrR

if strategy.position_size > 0 and flatLong
    strategy.close("Long", comment="mid")
    stopLevel := na
    takeLevel := na
if strategy.position_size < 0 and flatShort
    strategy.close("Short", comment="mid")
    stopLevel := na
    takeLevel := na

if strategy.position_size > 0 and not na(stopLevel)
    strategy.exit("L-exit", from_entry="Long", stop=stopLevel, limit=takeLevel)
if strategy.position_size < 0 and not na(stopLevel)
    strategy.exit("S-exit", from_entry="Short", stop=stopLevel, limit=takeLevel)

if strategy.position_size == 0 and strategy.position_size[1] != 0
    stopLevel := na
    takeLevel := na

plotshape(longCond, title="WT Long", style=shape.triangleup, location=location.belowbar, color=color.lime, size=size.small)
plotshape(shortCond, title="WT Short", style=shape.triangledown, location=location.abovebar, color=color.red, size=size.small)
